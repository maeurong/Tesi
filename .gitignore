graphify-out/
meshrec/graphify-out/

# Materiale di lavoro dei tutor (MeshReconstructorPro, ~767 MB) e articoli di
# riferimento (~179 MB): non prodotto del progetto. Toglierla dall'elenco e'
# tutto cio' che serve per versionarla.
MeshReconstructorPro/
Articoli/

# Dati di scansione (nuvole di punti, ~175 MB) e file di lavoro Abaqus: non
# prodotto del progetto. Toglierla dall'elenco e' tutto cio' che serve per
# versionarla.
Nuvole di punti
Cartella di lavoro Abaqus/

# Residui di un npm install finito nella radice per sbaglio (installazione di
# una dipendenza del plugin impeccable). Non fanno parte del progetto.
# La barra iniziale limita la regola alla radice: senza, i due nomi sarebbero
# ignorati in tutto l'albero, e un giorno un package.json legittimo dentro un
# sottoalbero sparirebbe senza che nessuno se ne accorga.
/node_modules/
/package.json
/package-lock.json

# Materiale di stesura della tesi: bibliografia in lavorazione e tavole
# esportate. Sono documenti binari che si riscrivono per intero a ogni
# salvataggio, quindi in git peserebbero come allegati e non come storia.
# Stessa ragione per cui Articoli/ resta fuori.
/fonti bibliografiche.docx
/muro_1.pdf

# Dispense del corso di Tecnica delle Costruzioni (lezioni 31-55) e la loro
# conversione in Markdown. Materiale didattico di terzi, come Articoli/: non
# prodotto del progetto, e non nostro da ridistribuire. Chi clona non le ha, e
# nessun documento del progetto deve dipendere dal fatto che ci siano: i numeri
# che ne discendono vanno ancorati all'articolo di norma, non alla dispensa.
/Lezioni CLS/

# Scarti di TetGen quando una faccia viene saltata: li scrive una corsa dentro
# meshrec/, non sono prodotto del progetto.
/meshrec/_skipped.*

# Toppe di appoggio usate per riportare a mano il lavoro di un worktree prima di
# rimuoverlo. Vivono quanto un merge.
/.claude/scratch-merge/

# Rumore del Finder, dal passaggio a macOS del 16/08/2026.
.DS_Store

# Registro di lavoro di subagent-driven-development: scratch per una fase,
# non prodotto del progetto. La storia di git e il documento di esiti sono il
# record; questo e la mappa di recupero del controllore mentre la fase gira.
.superpowers/

# I worktree locali. Ogni sottocartella qui dentro e' un checkout di QUESTO
# repository: tracciarla vorrebbe dire mettere il repository dentro se stesso, e
# un `git add -A` distratto committerebbe l'albero di lavoro di un ramo dentro
# un altro. Finche' e' restata fuori dall'elenco, `git status` la mostrava a
# ogni chiamata come non tracciata -- rumore fisso, che nasconde le righe che
# contano davvero.
/.claude/worktrees/

# `test_riferimenti_documenti.py` carica lo script di docs/validazione dal
# percorso: senza questa riga la suite lascia un __pycache__ fuori da meshrec/.
__pycache__/
